# =====================================================================
# SERVIDOR — nunca use o prefixo NEXT_PUBLIC_ aqui.
# Tudo com esse prefixo é embutido no JS enviado ao navegador.
# =====================================================================

# Conta que envia os e-mails do formulário de contato.
# No Gmail é obrigatório usar uma "senha de app" (a senha normal não funciona):
# https://myaccount.google.com/apppasswords
EMAIL_USER=seu-email@gmail.com
EMAIL_PASSWORD=

# Caixa que recebe as mensagens. Opcional: sem isso, usa EMAIL_USER.
EMAIL_TO=seu-email@gmail.com

# Personal access token do GitHub. Opcional, sem escopo nenhum já resolve.
# Sem ele a API pública funciona, mas com limite de 60 requisições/hora por IP
# (com token: 5.000/hora). https://github.com/settings/tokens
GIT_TOKEN=

# =====================================================================
# CLIENTE — expostas no navegador. Nunca coloque segredo aqui.
# =====================================================================

# URL canônica do site, usada nas tags Open Graph/Twitter.
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com

# Número do WhatsApp com DDD, só dígitos (o 55 do Brasil já é adicionado no código).
NEXT_PUBLIC_PHONE_NUMBER=21999999999

# Link do currículo. Opcional: sem isso, usa /DouglasJansey.pdf de public/.
NEXT_PUBLIC_CURRICULO=
